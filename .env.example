# Port the API server listens on (docker compose maps 8787:8787).
PORT=8787
# Session secret — generate one with: openssl rand -hex 32
# NOTE: sessions are currently random tokens stored in SQLite; the server does
# not read this value yet. It is part of the compose contract and reserved for
# signed-cookie sessions.
SESSION_SECRET=change-me-to-a-long-random-string
# SQLite database file (parent directory is created if missing).
# Docker compose sets this to /data/tet.sqlite3 on the tet-data volume.
DB_PATH=./data/tet.sqlite3
# Optional cloud TTS proxy; leave empty to serve none (web uses built-in voices)
TTS_PROVIDER=
TTS_API_KEY=
